{
  "name": "agent-office",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node agent-office-deploy/dist/server.js",
    "sync:dist": "node scripts/sync-dist.js",
    "sync:shell": "node scripts/sync-shell.js",
    "sync:shell:check": "node scripts/sync-shell.js --check",
    "test": "node --test tests/*.test.js",
    "package:youtube": "node scripts/package-youtube.mjs",
    "package:youtube:smoke": "node scripts/package-youtube.mjs --input fixtures/youtube-packaging/sample-input.json --now 2026-08-05T00:00:00.000Z --out fixtures/youtube-packaging/sample-output.md --out-json fixtures/youtube-packaging/sample-output.json --check",
    "package:youtube:fixtures": "node scripts/package-youtube.mjs --input fixtures/youtube-packaging/sample-input.json --now 2026-08-05T00:00:00.000Z --out fixtures/youtube-packaging/sample-output.md --out-json fixtures/youtube-packaging/sample-output.json --quiet"
  },
  "dependencies": {
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "playwright-core": "1.62.1"
  }
}
